# Copy to .env and fill in your own keys:  cp .env.example .env
# Secrets only (API keys, tokens). Configuration does not go here.
# Never commit .env. You only need the keys for the providers the team ends up choosing.

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
OPENAI_API_KEY=                 # GPT. Also covers Whisper API, OpenAI TTS, OpenAI embeddings
ANTHROPIC_API_KEY=              # Claude
GOOGLE_API_KEY=                 # Gemini
AWS_ACCESS_KEY_ID=              # Bedrock. Also covers Amazon Polly TTS
AWS_SECRET_ACCESS_KEY=
HF_TOKEN=                       # Hugging Face: gated open-weight models (Llama) and some embedding models

# ---------------------------------------------------------------------------
# Data & RAG
# ---------------------------------------------------------------------------
# Used by `uv run doit download_kaggle_dataset` (scripts/download_data.py).
# kaggle.com → Settings → API → Generate New Token
KAGGLE_API_TOKEN=

# ---------------------------------------------------------------------------
# MCP server
# ---------------------------------------------------------------------------
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# Voice (ASR + TTS)
# ---------------------------------------------------------------------------
# OpenAI and Amazon Polly use the keys in the LLM section. Local Whisper needs no key.
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=

# ---------------------------------------------------------------------------
# Evaluation (ProofAgent)
# ---------------------------------------------------------------------------
# Evaluation key from app.proofagent.ai → API keys → "Create evaluation key".
# Lets `proof run ... --upload` send the scorecard to the team's ProofAgent dashboard.
# The judge LLM uses the LLM key above (set the judge model in config, not here).
PROOFAGENT_API_KEY=

# ---------------------------------------------------------------------------
# Tracing (optional)
# ---------------------------------------------------------------------------
LANGSMITH_API_KEY=              # LangSmith tracing for debugging the LangGraph runs
